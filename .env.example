# Public app/build identifiers. Copy this file to .env.local and add your own
# values. Never commit passwords, private keys, or service-account credentials.
EAS_PROJECT_ID=
ADMOB_IOS_APP_ID=
ADMOB_ANDROID_APP_ID=

# Ad unit identifiers are embedded in the app bundle and are not secret, but
# keeping account-specific values outside the repository prevents accidental use.
EXPO_PUBLIC_ADMOB_BANNER_IOS_ID=
EXPO_PUBLIC_ADMOB_INTERSTITIAL_IOS_ID=
EXPO_PUBLIC_ADMOB_BANNER_ANDROID_ID=
EXPO_PUBLIC_ADMOB_INTERSTITIAL_ANDROID_ID=

