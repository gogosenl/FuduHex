# Dependencies and Expo local state
node_modules/
.expo/
.expo-shared/

# Generated builds and exports
dist/
dist-*/
web-build/
build/
*.ipa
*.apk
*.aab

# Local environment variables (never commit secrets)
.env
.env.*
!.env.example

# Apple / Android signing credentials
*.p8
*.p12
*.cer
*.mobileprovision
*.provisionprofile
*.jks
*.keystore
*.pem
*.key
credentials.json

# EAS / service credentials and logs
eas-build-*.json
google-services.json
GoogleService-Info.plist
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Store screenshots are not required to build the app
store-assets/

# Audio experiments; keep only the selected in-game sound
assets/audio/previews/*
!assets/audio/previews/select-bubble.wav

# Editor and operating-system files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

